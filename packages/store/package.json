{
  "name": "@sykamore/store",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:js": "tsup",
    "build:dts": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint --config ../../eslint.packages.config.js \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.7",
    "@sykamore/api-client": "workspace:*",
    "@sykamore/types": "workspace:*",
    "use-debounce": "^10.0.6",
    "zustand": "^4.3.9"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-native": ">=0.81.5"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "tsup": "~8.5.1",
    "typescript": "~5.9.2"
  }
}
