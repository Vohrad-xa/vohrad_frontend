{
  "expo": {
    "name": "vohrad",
    "slug": "vohrad-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/android/playstore-512.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vohrad.mobile",
      "icon": "./assets/icons/ios/playstore-512.png",
      "infoPlist": {
        "UIDesignRequiresCompatibility": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Face ID lets you unlock the app quickly and securely.",
        "NSCameraUsageDescription": "This app uses the camera to scan barcodes and QR codes for quick data entry."
      }
    },
    "android": {
      "icon": "./assets/icons/android/playstore-512.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android/playstore-512.png",
        "backgroundColor": "#00000000"
      },
      "playStoreUrl": "https://play.google.com/store/apps/details?id=vohrad.mobile",
      "predictiveBackGestureEnabled": true,
      "edgeToEdgeEnabled": true,
      "package": "vohrad.mobile",
      "permissions": ["CAMERA"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icons/web/favicon-48x48.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-camera",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/web/icon-512x512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/icons/web/icon-512x512.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "assetBundlePatterns": ["**/*"],
    "developmentClient": {
      "silentLaunch": true
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false,
      "remoteBuildCache": {
        "provider": "eas"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87c87a1b-17f0-4cb8-8884-80c0dca3cb59"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/87c87a1b-17f0-4cb8-8884-80c0dca3cb59"
    }
  }
}
