{
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.1",
    "turbo": "^2.6.3",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:dashboard": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "start": "turbo run start --parallel",
    "start:web": "turbo run start --filter=web",
    "start:mobile": "turbo run start --filter=mobile",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@vohrad/*",
    "watch:build": "turbo run build --filter=@vohrad/* --parallel -- --watch",
    "lint": "turbo run lint",
    "test": "jest",
    "typecheck": "turbo run typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "overrides": {
      "glob": "^10.4.5",
      "rimraf": "^6.0.1"
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
