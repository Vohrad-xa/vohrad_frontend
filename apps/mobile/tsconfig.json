{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@vohrad/api-client": ["../../packages/api-client/dist"],
      "@vohrad/auth": ["../../packages/auth/dist"],
      "@vohrad/store": ["../../packages/store/dist"],
      "@vohrad/types": ["../../packages/types/dist"]
    },
    "baseUrl": "."
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["docs"]
}
