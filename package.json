{
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.1",
    "turbo": "^2.8.1",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=web",
    "start": "turbo run start --parallel",
    "start:web": "turbo run start --filter=web",
    "start:mobile": "turbo run start --filter=mobile",
    "start:android": "turbo run start --filter=mobile -- --android",
    "start:ios": "turbo run start --filter=mobile -- --ios",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@sykamore/*",
    "watch:build": "turbo run build --filter=@sykamore/* --parallel -- --watch",
    "lint": "turbo run lint",
    "test": "jest",
    "typecheck": "turbo run typecheck",
    "format": "prettier . --write",
    "check:all": "turbo run lint && turbo run typecheck && turbo run format"
  },
  "packageManager": "pnpm@10.31.0",
  "pnpm": {
    "overrides": {
      "glob": "^13.0.1",
      "rimraf": "^6.0.1",
      "react": "19.2.0",
      "expo-constants": "55.0.9"
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
