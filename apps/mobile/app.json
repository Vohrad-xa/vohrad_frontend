{
  "expo": {
    "name": "sykamore",
    "slug": "sykamore",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icons/playstore-512.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sykamore.mobile",
      "icon": "./assets/icons/playstore-512.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Face ID lets you unlock the app quickly and securely.",
        "NSCameraUsageDescription": "This app uses the camera to scan barcodes and QR codes for quick data entry."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "icon": "./assets/icons/playstore-512.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/playstore-512.png",
        "backgroundColor": "#00000000"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "package": "sykamore.mobile",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-camera",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildReactNativeFromSource": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/playstore-512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/icons/playstore-512.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "react-native-share",
        {
          "ios": ["fb", "tg", "telegram", "ms-outlook", "mailto", "sgnl"],
          "android": [
            "com.facebook.katana",
            "org.telegram.messenger",
            "com.microsoft.office.outlook",
            "org.thoughtcrime.securesms"
          ],
          "enableBase64ShareAndroid": true
        }
      ]
    ],
    "assetBundlePatterns": ["**/*"],
    "developmentClient": {
      "silentLaunch": true
    },
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f447d0d9-933a-4b9e-a34f-e76682887ab4"
      }
    },
    "owner": "amineabb",
    "updates": {
      "url": "https://u.expo.dev/82b7131e-841a-46c9-970b-4426291c6480",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
