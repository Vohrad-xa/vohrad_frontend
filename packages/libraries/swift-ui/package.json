{
  "name": "@vohrad/swift-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Internal fork of Expo SwiftUI UI components",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "ios"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --config ../../../eslint.packages.config.js \"src/**/*.{ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "expo",
    "UI components",
    "SwiftUI"
  ],
  "license": "MIT",
  "dependencies": {
    "sf-symbols-typescript": "^2.1.0"
  },
  "peerDependencies": {
    "expo-modules-core": "^3.0.0",
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "expo-modules-core": "^3.0.26",
    "tsup": "^8.5.1",
    "typescript": "~5.9.2"
  }
}
