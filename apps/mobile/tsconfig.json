{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleSuffixes": [".ios", ".android", ".native", ""],
    "paths": {
      "@/*": ["./*"],
      "@sykamore/api-client": ["../../packages/api-client/dist"],
      "@sykamore/auth": ["../../packages/auth/dist"],
      "@sykamore/store": ["../../packages/store/dist"],
      "@sykamore/types": ["../../packages/types/dist"]
    },
    "baseUrl": "."
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["docs"]
}
