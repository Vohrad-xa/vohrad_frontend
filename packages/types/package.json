{
  "name": "@vohrad/types",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:js": "tsup",
    "build:dts": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint --config ../../eslint.packages.config.js \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:nocoverage": "jest --coverage=false",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "tsup": "^8.3.0",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "zod": "^4.1.12"
  }
}
