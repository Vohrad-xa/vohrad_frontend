{
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "tsup": "^8.3.0",
    "turbo": "^2.5.8",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:dashboard": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "start": "turbo run start --parallel",
    "start:web": "turbo run start --filter=web",
    "start:mobile": "turbo run start --filter=mobile",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@vohrad/*",
    "watch:build": "turbo run build --filter=@vohrad/* --parallel -- --watch",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "overrides": {
      "glob": "^10.4.5",
      "rimraf": "^6.0.1"
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
