{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2019", "DOM"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@vohrad/api-client": ["packages/api-client/src"],
      "@vohrad/auth": ["packages/auth/src"],
      "@vohrad/store": ["packages/store/src"],
      "@vohrad/types": ["packages/types/src"]
    }
  }
}
