{
  "expo": {
    "name": "sykamore",
    "slug": "sykamore-app",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icons/android/playstore-512.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sykamore.mobile",
      "icon": "./assets/icons/ios/playstore-512.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Face ID lets you unlock the app quickly and securely.",
        "NSCameraUsageDescription": "This app uses the camera to scan barcodes and QR codes for quick data entry."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "icon": "./assets/icons/android/playstore-512.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android/playstore-512.png",
        "backgroundColor": "#00000000"
      },
      "predictiveBackGestureEnabled": true,
      "edgeToEdgeEnabled": true,
      "package": "sykamore.mobile",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icons/web/favicon-48x48.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-camera",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/web/icon-512x512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/icons/web/icon-512x512.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "assetBundlePatterns": ["**/*"],
    "developmentClient": {
      "silentLaunch": true
    },
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82b7131e-841a-46c9-970b-4426291c6480"
      }
    },
    "owner": "sykamore-app",
    "updates": {
      "url": "https://u.expo.dev/82b7131e-841a-46c9-970b-4426291c6480"
    }
  }
}
