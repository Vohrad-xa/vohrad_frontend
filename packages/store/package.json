{
  "name": "@vohrad/store",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:js": "tsup",
    "build:dts": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint --config ../../eslint.packages.config.js \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "zustand": "^4.3.9",
    "@vohrad/types": "workspace:*",
    "@vohrad/api-client": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.1.0",
    "react-native": ">=0.81.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "~5.9.2"
  }
}
