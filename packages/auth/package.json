{
  "name": "@sykamore/auth",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:js": "tsup",
    "build:dts": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint --config ../../eslint.packages.config.js \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@sykamore/api-client": "workspace:^0.0.0",
    "@sykamore/store": "workspace:^0.0.0",
    "@sykamore/types": "workspace:^0.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.9",
    "tsup": "~8.5.1",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
